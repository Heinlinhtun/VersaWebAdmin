@model Versa.Core.Models.EditShopViewModel

@{
    ViewData["Title"] = "Edit Shop";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white p-3">
            <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Shop: @Model.ShopName</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="UpdateShop" method="post">
                <input type="hidden" asp-for="TenantId" />
                <input type="hidden" asp-for="DbName" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Shop Name (ဆိုင်အမည်)</label>
                        <input asp-for="ShopName" class="form-control" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Shop Type (ဆိုင်အမျိုးအစား)</label>
                        <input asp-for="ShopType" class="form-control">
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Contact Number (ဖုန်းနံပါတ်)</label>
                        <input asp-for="ContactNumber" class="form-control">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Address (လိပ်စာ)</label>
                        <input asp-for="Address" class="form-control">
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Max Users (ခွင့်ပြုမည့်ဝန်ထမ်းအရေအတွက်)</label>
                        <input asp-for="MaxUsers" type="number" class="form-control" min="1" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Subscription Plan</label>
                        <input asp-for="SubscriptionPlan" class="form-control" required>
                    </div>

                    <div class="col-md-12 mb-3 mt-3">
                        <div class="p-3 bg-light rounded border border-warning">
                            <h6 class="text-danger fw-bold mb-2"><i class="bi bi-shield-lock me-1"></i> Admin Password Reset (စကားဝှက်အသစ်)</h6>
                            <p class="text-muted small mb-2">Leave blank to keep current password. (မပြောင်းလဲလိုပါက အလွတ်ထားပါ။)</p>
                            <input asp-for="NewAdminPassword" type="password" class="form-control" placeholder="Enter new password">
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                    <a asp-action="ShopList" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
