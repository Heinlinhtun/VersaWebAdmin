@model Versa.Core.Models.Tenant

@{
    ViewData["Title"] = "Renew Subscription";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white p-3">
            <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Renew Subscription: @Model.ShopName</h5>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-info">
                Current Subscription Ends: <strong>@Model.SubscriptionEndDate.ToString("dd/MM/yyyy")</strong>
            </div>

            <form asp-action="ProcessRenew" method="post">
                <input type="hidden" name="TenantId" value="@Model.TenantId" />
                
                <div class="mb-4">
                    <label class="form-label fw-bold text-primary">Select Subscription Plan (သက်တမ်းတိုးရန် ပလန်ရွေးချယ်ပါ)</label>
                    <select name="PlanMonths" class="form-select border-primary shadow-sm" required>
                        <optgroup label="Short Term">
                            <option value="1">၁ လစာ (Trial Upgrade)</option>
                            <option value="6">၆ လစာ (Standard)</option>
                        </optgroup>
                        <optgroup label="Long Term (Recommended)">
                            <option value="12" selected>၁ နှစ်စာ (Pro Plan)</option>
                            <option value="24">၂ နှစ်စာ (Value Plan)</option>
                            <option value="36">၃ နှစ်စာ (Business Plan)</option>
                            <option value="60">၅ နှစ်စာ (Enterprise Plan - Life Time Deal)</option>
                        </optgroup>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4" onclick="return confirm('Are you sure you want to renew this subscription?')">
                        <i class="bi bi-check-circle me-1"></i> Confirm Renewal
                    </button>
                    <a asp-action="ShopList" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
