@{
    ViewData["Title"] = "Mac Address Encryption";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Mac Address Encryption Tool</h5>
                </div>
                <div class="card-body">
                    @Html.AntiForgeryToken()
                    <p class="text-muted small">Enter the user's MAC Address to generate an encrypted key.</p>
                    
                    <div class="mb-3">
                        <label for="macAddress" class="form-label">MAC Address</label>
                        <input type="text" id="macAddress" class="form-control" placeholder="e.g. 00-B0-D0-63-C2-26" autofocus>
                    </div>
                    
                    <div class="d-grid gap-2 mb-4">
                        <button id="btnEncrypt" class="btn btn-primary" onclick="encryptMac()">
                            <span id="btnText">Generate Encrypted Key</span>
                            <span id="btnLoading" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        </button>
                    </div>

                    <div id="resultContainer" class="d-none">
                        <label for="encryptedKey" class="form-label">Generated Key</label>
                        <div class="input-group">
                            <input type="text" id="encryptedKey" class="form-control bg-light" readonly>
                            <button class="btn btn-outline-secondary" type="button" id="btnCopy" onclick="copyToClipboard()">
                                <svg width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16">
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                                    <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                </svg> Copy
                            </button>
                        </div>
                        <div id="copyFeedback" class="text-success small mt-1 d-none">
                            Copied to clipboard!
                        </div>
                    </div>

                    <div id="errorContainer" class="alert alert-danger d-none mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function encryptMac() {
            const macInput = document.getElementById('macAddress');
            const macAddress = macInput.value.trim();
            const btnEncrypt = document.getElementById('btnEncrypt');
            const btnText = document.getElementById('btnText');
            const btnLoading = document.getElementById('btnLoading');
            const resultContainer = document.getElementById('resultContainer');
            const encryptedKeyInput = document.getElementById('encryptedKey');
            const errorContainer = document.getElementById('errorContainer');

            if (!macAddress) {
                showError("Please enter a MAC address.");
                return;
            }

            // UI State: Loading
            btnEncrypt.disabled = true;
            btnText.innerText = "Encrypting...";
            btnLoading.classList.remove('d-none');
            resultContainer.classList.add('d-none');
            errorContainer.classList.add('d-none');

            try {
                const response = await fetch('/Admin/EncryptMac', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                    },
                    body: JSON.stringify({ macAddress: macAddress })
                });

                const data = await response.json();

                if (data.success) {
                    encryptedKeyInput.value = data.encryptedKey;
                    resultContainer.classList.remove('d-none');
                } else {
                    showError(data.message || "Encryption failed.");
                }
            } catch (err) {
                showError("An unexpected error occurred. Please try again.");
                console.error(err);
            } finally {
                // UI State: Reset
                btnEncrypt.disabled = false;
                btnText.innerText = "Generate Encrypted Key";
                btnLoading.classList.add('d-none');
            }
        }

        function showError(msg) {
            const errorContainer = document.getElementById('errorContainer');
            errorContainer.innerText = msg;
            errorContainer.classList.remove('d-none');
        }

        async function copyToClipboard() {
            const copyText = document.getElementById("encryptedKey");
            const feedback = document.getElementById("copyFeedback");
            
            try {
                await navigator.clipboard.writeText(copyText.value);
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    feedback.classList.add('d-none');
                }, 2000);
            } catch (err) {
                // Fallback for older browsers or insecure contexts
                copyText.select();
                document.execCommand("copy");
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    feedback.classList.add('d-none');
                }, 2000);
            }
        }

        // Allow Enter key to trigger encryption
        document.getElementById('macAddress').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                encryptMac();
            }
        });
    </script>
}
